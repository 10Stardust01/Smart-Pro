  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "ReviewerDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REQUEST_CHANGES"
            ],
            "title": "Decision"
          },
          "comment": {
            "type": "string",
            "maxLength": 4000,
            "title": "Comment",
            "default": ""
          },
          "expectedCaseVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expectedcaseversion"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "expectedCaseVersion"
        ],
        "title": "ReviewerDecision"
      },
      "SubmitAttempt": {
        "properties": {
          "documentVersionIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Documentversionids"
          },
          "expectedCaseVersion": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expectedcaseversion"
          }
        },
        "type": "object",
        "required": [
          "documentVersionIds",
          "expectedCaseVersion"
        ],
        "title": "SubmitAttempt"
      }
    }
  }
